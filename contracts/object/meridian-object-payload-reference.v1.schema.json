{
  "$comment": "SPDX-License-Identifier: Apache-2.0",
  "$id": "https://github.com/zephytiju/MeridianObjectCommon/contracts/object/meridian-object-payload-reference.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Meridian V1 process-local payload reference",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "token", "expectedLength", "expectedDigest", "replayable"],
  "properties": {
    "formatVersion": { "const": "meridian.object.payload-reference.v1" },
    "token": { "type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._~-]{0,510}[A-Za-z0-9])?$" },
    "expectedLength": { "type": ["integer", "null"], "minimum": 0 },
    "expectedDigest": { "anyOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
    "replayable": { "type": "boolean" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
